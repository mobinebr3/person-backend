datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==================== ENUMS ====================

enum TemplateType {
  CALENDAR  // برای مدیریت زمان و رویدادها
  BOARD     // برای مدیریت تسک‌ها (Kanban)
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReminderMethod {
  EMAIL
  PUSH
  SMS
}

enum NotificationType {
  INVITE
  REMINDER
  SYSTEM
  TASK_ASSIGNED
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SharePermission {
  VIEW
  EDIT
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== USER & AUTH ====================

model User {
  id               String         @id @default(uuid())
  name             String?
  email            String         @unique
  passwordHash     String         @map("password_hash")
  refreshTokenHash String?        @map("refresh_token_hash")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  pages            Page[]
  events           Event[]
  tasks            Task[]
  pageShares       PageShare[]
  taskAssignments  TaskAssignment[]
  taskComments     TaskComment[]
  labels           Label[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  roles            UserRole[]
  settings         UserSettings?

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId Int    @map("role_id")
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==================== CORE MODELS ====================

model Template {
  id        String       @id @default(uuid())
  name      String
  type      TemplateType // CALENDAR یا BOARD
  config    Json         // تنظیمات اضافی (ستون‌های پیش‌فرض و غیره)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  
  pages     Page[]

  @@map("templates")
}

model Page {
  id         String    @id @default(uuid())
  pageId     String    @unique
  ownerId    String    @map("owner_id")
  templateId String?   @map("template_id")
  title      String
  color      String?
  isShared   Boolean   @default(false) @map("is_shared")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  // برای صفحات تقویم محور (template.type = CALENDAR)
  events     Event[]
  
  // برای صفحات کانبان محور (template.type = BOARD)
  tasks      Task[]
  
  shares     PageShare[]

  @@index([ownerId])
  @@index([templateId])
  @@map("pages")
}

// ==================== EVENTS (برای صفحات CALENDAR) ====================

model Event {
  id           String           @id @default(uuid())
  pageId       String           @map("page_id")
  ownerId      String           @map("owner_id")
  title        String
  description  String?
  startTimeUtc DateTime         @map("start_time_utc")
  endTimeUtc   DateTime         @map("end_time_utc")
  isAllDay     Boolean          @default(false) @map("is_all_day")
  isRecurring  Boolean          @default(false) @map("is_recurring")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  page         Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  recurrence   EventRecurrence?
  instances    EventInstance[]
  reminders    Reminder[]

  @@index([pageId])
  @@index([ownerId])
  @@index([startTimeUtc])
  @@index([endTimeUtc])
  @@map("events")
}

model EventRecurrence {
  id         String         @id @default(uuid())
  eventId    String         @unique @map("event_id")
  freq       RecurrenceFreq
  interval   Int            @default(1)
  byDay      String?        @map("by_day")
  byMonthDay Int?           @map("by_month_day")
  until      DateTime?
  count      Int?
  createdAt  DateTime       @default(now()) @map("created_at")

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_recurrences")
}

model EventInstance {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  startTimeUtc DateTime @map("start_time_utc")
  endTimeUtc   DateTime @map("end_time_utc")
  isCancelled  Boolean  @default(false) @map("is_cancelled")

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([startTimeUtc])
  @@map("event_instances")
}

model Reminder {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  minutesBefore Int            @map("minutes_before")
  method        ReminderMethod
  isSent        Boolean        @default(false) @map("is_sent")
  
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ==================== TASKS (برای صفحات BOARD) ====================

model Task {
  id          String       @id @default(uuid())
  pageId      String       @map("page_id")
  ownerId     String       @map("owner_id")
  title       String
  description String?
  status      JobStatus
  priority    TaskPriority @default(MEDIUM)
  order       Int          @default(0)
  dueDate     DateTime?    @map("due_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  page        Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  assignments TaskAssignment[]
  labels      TaskLabel[]
  comments    TaskComment[]

  @@index([pageId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model Label {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  name      String
  color     String
  createdAt DateTime    @default(now()) @map("created_at")
  
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([userId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")
  
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

// ==================== SHARING ====================

model PageShare {
  id          String          @id @default(uuid())
  pageId      String          @map("page_id")
  userId      String          @map("user_id")
  permission  SharePermission
  createdAt   DateTime        @default(now()) @map("created_at")
  
  page        Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("page_shares")
}

// ==================== NOTIFICATIONS & AUDIT ====================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false) @map("is_read")
  sentAt    DateTime         @default(now()) @map("sent_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model SchedulerJob {
  id          String   @id @default(uuid())
  jobType     String   @map("job_type")
  referenceId String   @map("reference_id")
  executeAt   DateTime @map("execute_at")
  status      JobStatus
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([executeAt])
  @@map("scheduler_jobs")
}

model UserSettings {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  timezone        String  @default("UTC")
  dateFormat      String  @default("YYYY-MM-DD") @map("date_format")
  timeFormat      String  @default("24h") @map("time_format")
  weekStartsOn    Int     @default(0) @map("week_starts_on")
  defaultView     String  @default("week") @map("default_view")
  theme           String  @default("light")
  language        String  @default("en")
  notifications   Json    @default("{}")
  
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}